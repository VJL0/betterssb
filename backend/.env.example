DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Add GOOGLE_REDIRECT_URI below, exactly, under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the browser lands after signing in.
FRONTEND_URL=http://localhost:5173

# Required, at least 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET=
# SESSION_IDLE_TIMEOUT_DAYS=7
# SESSION_ABSOLUTE_TIMEOUT_DAYS=30
# Keep true, including for http://localhost. Set false only to test over plain HTTP on another host.
# SESSION_COOKIE_SECURE=true

OPENAI_API_KEY=
RMP_AUTH_TOKEN=
