DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Required, at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

OPENAI_API_KEY=
RMP_AUTH_TOKEN=

# Exact origins allowed to call the API (JSON list). In production, list the
# published extension and the web app, e.g.
# CORS_ORIGINS=["chrome-extension://<store-extension-id>","https://app.example.com"]
CORS_ORIGINS=[]
# Local dev only: allow any unpacked extension. Leave unset in production.
CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
