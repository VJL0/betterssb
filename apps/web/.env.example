# Copy to .env (or .env.production) and fill in. Values are baked in at build time.

# Chrome Web Store listing for the extension. Leave empty until it's published;
# "Add to Chrome" buttons stay hidden while it's unset.
NEXT_PUBLIC_EXTENSION_INSTALL_URL=

# The site's public origin, for canonical links, the sitemap and social cards.
SITE_URL=http://localhost:3000

# The FastAPI server that /api is proxied to.
API_ORIGIN=http://localhost:8000

# Sentry project betterssb-web (Settings → Client Keys). Empty turns Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map uploads (Settings → Auth Tokens). Never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
