    "sha256": "f149d227516c265ef970bfe9b3ebd72ad1608a042f2b36be4fb4357697ed130d",
    "text": "Transcripts: Complete official transcripts for all undergraduate coursework must be submitted.",
    "url": "https://bulletin.temple.edu/graduate/scd/dentistry/dentistry-dmd/"
   },
   "label": "Transcripts",
   "value": "Complete official transcripts for all undergraduate coursework must be submitted."
  },
  {
   "evidence": {
    "locator": {
     "bbox": null,
     "line": 454,
     "page": null,
