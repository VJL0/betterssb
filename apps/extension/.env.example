# Copy to .env (or .env.development / .env.production) and fill in.
# Values are baked into the extension at build time.

# Backend API origin (paths start with /api). Its host is also added to the
# manifest's host_permissions, which is how the extension calls the API without CORS.
WXT_API_ORIGIN=http://localhost:8000

# The BetterSSB website, opened from the popup ("Open in BetterSSB").
WXT_WEB_ORIGIN=http://localhost:3000

# Optional: the Banner registration page students sign in to (defaults to Temple's).
# WXT_BANNER_REGISTRATION_URL=https://prd-xereg.temple.edu/StudentRegistrationSsb/ssb/registration
