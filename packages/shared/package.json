{
  "name": "@workspace/shared",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    "./types/*": "./src/types/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./testing/*": "./src/testing/*.ts"
  },
  "dependencies": {
    "@workspace/api-client": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
