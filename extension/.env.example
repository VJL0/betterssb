# Copy to .env (or .env.development / .env.production) and fill in.
# Values are baked into the extension at build time.

# Backend API base URL. Its host is also added to the manifest's host_permissions,
# which is how the extension calls the API without CORS.
WXT_API_URL=http://localhost:8000/api

# Google Cloud Console → OAuth 2.0 Client ID (same as backend GOOGLE_CLIENT_ID)
WXT_GOOGLE_CLIENT_ID=
